# cp .env.example .env    — never commit .env

# Bearer token for the CONSOLE API (dev-console-lmu…) — used for VM deletes.
# Grab from browser devtools: Network tab → any API call → Authorization header.
API_TOKEN=

# Bearer token for the ADMIN API — optional. Leave blank and set
# ADMIN_USERNAME / ADMIN_PASSWORD below to have tokens minted automatically.
ADMIN_TOKEN=

# ---- Credentials for minting admin tokens (password grant) ----
# With these set you never paste a token: they are fetched on demand, cached,
# and renewed just before the ~5 minute expiry.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ---- Hosts (all optional; each has a default in config.yaml) ----
# Point the tool at a different environment without editing config.yaml.
ADMIN_BASE_URL=
CONSOLE_BASE_URL=
CE_REGION=

# Keycloak. AUTH_BASE_URL defaults to ADMIN_BASE_URL when left blank.
AUTH_BASE_URL=
AUTH_REALM=
AUTH_CLIENT_ID=

# NOTE: these tokens expire after ~5 minutes. Pasting them into the web UI is
# usually better than keeping them here — the UI holds them in sessionStorage
# (never on disk) and prompts you to re-paste when one expires.

# ---- Infra cluster MongoDB (reached through kubectl port-forward) ----
MONGO_USER=
MONGO_PASSWORD=
MONGO_DB=

# Optional: path to the kubeconfig kubectl should use for the port-forward.
# Leave blank to use your current default context.
KUBECONFIG=

# ---- In-cluster Keycloak --------------------------------------------------
# `http://keycloak` is a Service DNS name: it resolves inside the cluster only,
# so tokens are minted through a kubectl port-forward to svc/keycloak. This is
# on by default for the environment whose Keycloak is not published.
#
# Credentials for that realm (see config.yaml: realm defaults to uhc-dha).
PROD_ADMIN_USERNAME=
PROD_ADMIN_PASSWORD=
# Cluster hosting svc/keycloak. Blank namespace/kubeconfig keep the defaults
# from config.yaml (uhc-dev) and your current kubectl context.
PROD_AUTH_NAMESPACE=
PROD_AUTH_KUBECONFIG=
# Set to false to skip the tunnel and post straight to PROD_AUTH_BASE_URL.
PROD_AUTH_PORT_FORWARD=

# Same switches for the dev environment, whose Keycloak *is* published — set
# both to route its minting through the cluster instead.
AUTH_BASE_URL=
AUTH_PORT_FORWARD=
