node_modules/
.env
config.yaml
logs/
.kubeconfigs/
*.log
.DS_Store

# Editor/tool settings can capture pasted tokens — keep them out.
.claude/

# Real secret manifests never get committed.
k8s/secret.yaml
helm/**/charts/
helm/**/*.tgz
# ...except the bundled source, which IS the deploy artifact in bundled mode:
# package-src.sh writes it and Argo CD can only see it if it is committed.
!helm/**/files/src.tgz
